# MySQL account with access to this project's dedicated database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=machine_failure_dashboard
DB_USER=machine_failure_app
DB_PASSWORD=YOUR_APP_PASSWORD

# Leave empty for a local demo. Set a secret key before exposing write endpoints.
DEMO_API_KEY=
API_URL=http://127.0.0.1:8001

# Optional cloud MySQL certificate authority file.
DB_SSL_CA=
